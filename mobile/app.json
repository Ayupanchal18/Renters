{
  "expo": {
    "name": "Renters",
    "slug": "renters-mobile",
    "version": "0.1.0",
    "icon": "./assets/images/logo.png",
    "orientation": "portrait",
    "scheme": "renters",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.renters.app",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "your-google-maps-api-key-here"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#10b981"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "extra": {
      "projectName": "Renters Mobile Skeleton",
      "eas": {
        "projectId": "cb5d9982-3d00-418c-a831-11df727e4f32"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Renters to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-speech-recognition",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "bundleIdentifier": "com.renters.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    }
  }
}
