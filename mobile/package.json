{
  "name": "renters-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "setup": "node scripts/setup-dev.js",
    "start": "node scripts/setup-dev.js && expo start --clear",
    "android": "node scripts/setup-dev.js && expo run:android",
    "prebuild": "expo prebuild --platform android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "apk:arm64": "cd android && gradlew.bat assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "apk:bundle": "cd android && gradlew.bat bundleRelease",
    "clean": "cd android && gradlew.bat clean",
    "typecheck": "tsc --noEmit",
    "ios": "node scripts/setup-dev.js && expo run:ios"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.7.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native/babel-preset": "^0.76.6",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.84.2",
    "axios": "^1.13.2",
    "color": "^5.0.3",
    "color-string": "^2.1.4",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.10",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^55.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.2",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "is-arrayish": "^0.3.4",
    "lucide-react-native": "^0.575.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "^1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "simple-swizzle": "^0.2.4",
    "socket.io-client": "^4.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
